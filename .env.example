# Sentinel — example environment.
# Copy to .env and change every value marked CHANGEME before any non-local use.
# .env is gitignored. Never commit real credentials.

# ---------------------------------------------------------------- environment
SENTINEL_ENV=development            # development | staging | production
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------- database
# The application MUST connect as a non-owner, NOBYPASSRLS role.
POSTGRES_DB=sentinel
POSTGRES_APP_USER=sentinel_app
POSTGRES_APP_PASSWORD=CHANGEME_app
POSTGRES_MIGRATE_USER=sentinel_migrate
POSTGRES_MIGRATE_PASSWORD=CHANGEME_migrate
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGEME_super
DATABASE_URL=postgresql+psycopg://sentinel_app:CHANGEME_app@postgres:5432/sentinel
MIGRATION_DATABASE_URL=postgresql+psycopg://sentinel_migrate:CHANGEME_migrate@postgres:5432/sentinel

# ---------------------------------------------------------------- redis
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- object storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGEME_minio
S3_SECRET_KEY=CHANGEME_minio_secret
S3_REGION=us-east-1
S3_BUCKET_EVIDENCE=sentinel-evidence
S3_BUCKET_TESTCASES=sentinel-testcases
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------- signing keys
# "file" is REJECTED when SENTINEL_ENV=production — the API refuses to start.
# Production must use a KMS/HSM the database administrator cannot administer.
SIGNING_KEY_PROVIDER=file           # file | kms
SIGNING_KEY_PATH=/run/keys/audit_ed25519.key
SIGNING_KEY_REF=

# Access-token signing (EdDSA). Separate key from the audit chain key.
JWT_PRIVATE_KEY_PATH=/run/keys/jwt_ed25519.key
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
JWT_ISSUER=sentinel

# ---------------------------------------------------------------- security
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SECURE=false                 # MUST be true anywhere with TLS
MFA_REQUIRED_ROLES=org_admin,reviewer
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILURES=5

# ---------------------------------------------------------------- integrity
EVIDENCE_MAX_PER_SESSION=40
EVIDENCE_COOLDOWN_SECONDS=20
EVIDENCE_MAX_LONG_EDGE=640
EVIDENCE_JPEG_QUALITY=0.7
EVENT_LATE_THRESHOLD_SECONDS=30
EVENT_RATE_PER_MINUTE=60
RETENTION_DEFAULT_DAYS=30
RETENTION_APPEAL_EXTENSION_DAYS=60

# ---------------------------------------------------------------- judge
JUDGE_MAX_CONCURRENT=8
JUDGE_DOCKER_HOST=unix:///var/run/docker.sock
JUDGE_DEFAULT_TIME_LIMIT_MS=2000
JUDGE_DEFAULT_MEMORY_MB=256

# ---------------------------------------------------------------- seed (dev only)
# Ignored unless SENTINEL_ENV=development.
SEED_ORG_SLUG=demo-university
SEED_PASSWORD=CHANGEME_seed_password
